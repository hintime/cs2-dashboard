# Debug/temp files
_*.py
_*.ps1
_*.json
_*.txt
_*.log

# Python cache
__pycache__/
*.pyc
*.bak

# Private keys (NEVER commit)
eco_private_key.txt
*.pem
*.key
run_update.cmd

# Large data files (uploaded via CI, not git)
*.db
*.db-wal
*.db-shm
git_credential.txt

# price_history.json 已废弃：由本地 SQLite 取代，不再入库
price_history.json

# 运行时日志（每轮更新都在变化，不应入库）
*.log
update_log.txt

# 本机运行时密钥（云端走 Secrets，此文件仅本机使用）
local_keys.env

# 本机调度器（updater_daemon.py）的运行时文件
.updater.lock
.updater_state.json
logs/
.runner_local/

# 数据迁移前的一次性备份（cs2-move-data.py 产出，不入库）
.pre_switch_backup/
