_*.txt
_*.log

# Python cache
__pycache__/
*.pyc
*.bak

# Private keys (NEVER commit)
eco_private_key.txt
*.pem
*.key
run_update.cmd

# Large data files (uploaded via CI, not git)
*.db
*.db-wal
*.db-shm
git_credential.txt

# price_history.json 已废弃：由本地 SQLite 取代，不再入库
price_history.json

# 运行时日志（每轮更新都在变化，不应入库）
*.log
update_log.txt

# 本机运行时密钥（云端走 Secrets，此文件仅本机使用）
local_keys.env

# 本机调度器（updater_daemon.py）的运行时文件
.updater.lock
.updater_state.json
logs/
.runner_local/

# 数据迁移前的一次性备份（cs2-move-data.py 产出，不入库）
.pre_switch_backup/

# 阶段0 改动前的原件备份（仅本机保留用于回滚，不入库）
backup/

# ── 2026-09-16：移出 git 的大体积数据 / 内部文档 ──
# 原因：Pages 用 legacy「从分支部署」，分支里有什么就公开发布什么。
# 这些文件前端零引用（已核实），但会随站点公开，共约 377 MB。
# 这些文件**仅保留在本机**，换机器 clone 不会带过来 —— 需要时另行备份。
market_history/
index_history/
__pycache__/
tools/*
# ⚠ 例外：服务器端**必须随仓库走**的脚本（2026-10-07 加）。
#   tools/ 整体排除是刻意的（本地草稿、临时诊断脚本一堆），
#   但这两个是 cron 实际调用的入口，不在仓库里就等于「换机器必丢」。
# ⚠ 必须用 `tools/*` + `!tools/文件名` 而不是 `tools/`：
#   git **不会进入已排除的目录**，所以写在 `tools/` 下面的例外规则永远不生效。
!tools/fetch_steamdt_kline.py
!tools/run_sdkline.sh
buff_history.json
eco_catalog.json
ROOT_FIX.md
OPTIMIZE_REPORT.md
OPTIMIZATION_LOG.md
UPDATER_README.md
CLOUDFLARE_SETUP.md
最后一步-手动安装计划任务.md

# ── watchdog/（2026-09-21 纳入仓库）──
watchdog/*.env
watchdog/.wecom_token.json
watchdog/*.log
watchdog/last_result.json
watchdog/__pycache__/
watchdog/*.bak*
!tools/hold_fast_sample.py
!tools/run_hold_fast.sh
!tools/holdings_push.py
!tools/holdings_auto_pull.py
!tools/run_holdings_pull.sh

# ── 运行时标记/状态文件（不入库）──
.workbuddy/
.push_failed
.steamdt_batch.slot
.kline_pushed/
# 时间戳备份（形如 xxx.bak.20260925_173440，不匹配上面的 *.bak）
*.bak.*
